DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Mặc định bằng CORS_ALLOWED_ORIGINS nếu bỏ trống
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# infrastructure/docker-compose.dev.yml
DATABASE_URL=postgres://labelx:labelx@localhost:5432/labelx
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
FINAL_RUN_AUTO_DISPATCH=true

# Faster R-CNN: make detector-up; token ngẫu nhiên >=32 ký tự, không commit.
DETECTOR_WORKER_URL=http://127.0.0.1:8501
DETECTOR_SERVICE_TOKEN=
# Mặc định checkpoint: <repo>/.cache/models/faster_rcnn_r50_fpn_3x_det_bdd100k.pth
# Nếu đặt path, phải là path HOST nhìn thấy từ Django/Celery, KHÔNG phải /models hay /app.
# DETECTOR_CHECKPOINT_PATH=/absolute/host/path/faster_rcnn_r50_fpn_3x_det_bdd100k.pth
# Manifest mặc định: <repo>/src/detector_worker/model-manifest.json
DETECTOR_DEVICE=cuda:0
DETECTOR_TIMEOUT_SECONDS=1800
# Kết nối remote qua Tailscale Serve HTTPS; exact hostname do vận hành cho phép.
GPU_WORKER_ALLOWED_HOSTS=
# JSON map alias -> secret. UI chỉ thấy alias; KHÔNG đặt token thật trong file mẫu/Git.
GPU_WORKER_CREDENTIALS={}

# Object Storage S3-compatible (SeaweedFS ở local; môi trường thật dùng storage hiện có)
OBJECT_STORAGE_ENDPOINT_URL=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=labelx
OBJECT_STORAGE_SECRET_KEY=labelx-secret
OBJECT_STORAGE_BUCKET=labelx-evidence
# Bucket theo loại dữ liệu (docker-compose.dev.yml tạo sẵn ba bucket này)
OBJECT_STORAGE_BUCKET_SNAPSHOTS=labelx-snapshots
OBJECT_STORAGE_BUCKET_EVIDENCE=labelx-evidence
OBJECT_STORAGE_BUCKET_REPORTS=labelx-reports
OBJECT_STORAGE_REGION=us-east-1
# URL tải tạm thời chỉ được sinh sau khi backend kiểm quyền (1–3600 giây)
OBJECT_STORAGE_PRESIGNED_TTL_SECONDS=300

# CVAT dev v2.77.0 — PAT/service account PHẢI chỉ có quyền đọc
CVAT_BASE_URL=http://localhost:8080
CVAT_SERVICE_TOKEN=

# M-03 pilot policy (DEC-019 / CR-113). Same as the built-in defaults; set only to override.
REVIEW_LEASE_TTL_SECONDS=900
REVIEW_INCOMPLETE_RESERVATION_SECONDS=300
EFFORT_IDLE_POLICY={"source":"DEC-019/P03","decision_status":"approved_for_pilot","t_idle_seconds":120,"version":"pilot-1"}
