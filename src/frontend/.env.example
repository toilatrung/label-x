# Django REST API (src/backend) — base URL dùng cho openapi-fetch
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Empty: mock during local development, real backend in production.
# Set backend to use real auth locally. Mock is always disabled in production.
NEXT_PUBLIC_AUTH_MODE=
# Deep link sang CVAT để sửa annotation (adapter chỉ đọc — B-18)
NEXT_PUBLIC_CVAT_BASE_URL=http://localhost:8080
