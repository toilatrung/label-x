# Django REST API (src/backend). Mặc định: trình duyệt gọi cùng origin với UI và Next proxy /api sang
# LABELX_API_PROXY_TARGET (cookie sessionid/csrftoken thuộc host của UI, không đụng CVAT cùng host).
LABELX_API_PROXY_TARGET=http://127.0.0.1:8000
# Timeout proxy (ms, mặc định 300000; Next mặc định 30000 sẽ cắt thao tác dài). Đọc khi build/khởi động.
# LABELX_API_PROXY_TIMEOUT_MS=300000
# Chỉ đặt khi muốn gọi backend trực tiếp (cross-site, UI và API phải cùng tên host, vd cùng 127.0.0.1):
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# Default: real backend in every environment.
# Set mock explicitly only for development fixtures. Mock is disabled in production.
NEXT_PUBLIC_AUTH_MODE=backend
# Deep link sang CVAT để sửa annotation (adapter chỉ đọc — B-18)
NEXT_PUBLIC_CVAT_BASE_URL=http://localhost:8080
