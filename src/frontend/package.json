{
  "name": "labelx-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/api/schema/ -o src/lib/api/schema.d.ts",
    "pretest": "npm run gen:api:contract",
    "test": "vitest run",
    "gen:api:contract": "openapi-typescript ../../docs/04-api/openapi.yaml -o src/lib/api/contract.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.0",
    "next": "16.3.8",
    "openapi-fetch": "^0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.9.0",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
